<Window x:Class="CatClipComposer.LayerItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CatClipComposer.Controls"
        Title="Layer item" Width="700" Height="760" MinWidth="620" MinHeight="580"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="14" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="SourceFields" Margin="0,0,0,10">
                        <TextBlock x:Name="SourceLabel" Margin="0,0,0,4" Text="Source file" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceTextBox" TextChanged="SourceTextBox_TextChanged" />
                            <Button Grid.Column="1" Margin="5,0,0,0" Click="Browse_Click" Content="Browse…" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="OverlayOpacityField" Margin="0,0,0,10">
                        <TextBlock Margin="0,0,0,4" Text="Opacity (%)" />
                        <controls:NumericEditorControl x:Name="OverlayOpacityEditor"
                                                       Minimum="0" Maximum="100" Step="5"
                                                       Edited="OverlayOpacityEditor_Edited" />
                    </StackPanel>

                    <Border x:Name="ImagePreviewFields" Height="210" Margin="0,0,0,10" Padding="6"
                            Background="{StaticResource PreviewBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="ImagePreviewStatusText" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{StaticResource FaintTextBrush}"
                                       Text="Choose a PNG or image to preview it here." />
                            <Image x:Name="ImageOverlayPreview" Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <StackPanel x:Name="TextFields" Margin="0,0,0,10">
                        <TextBlock Margin="0,0,0,4" Text="Text" />
                        <TextBox x:Name="OverlayTextBox" Height="70" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel x:Name="FontFields" Margin="0,0,0,10">
                        <TextBlock Margin="0,0,0,4" Text="Font" />
                        <ComboBox x:Name="FontComboBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Details}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{Binding PreviewFontFamily}" Text="{Binding FamilyName}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="9"
                                                   Foreground="{StaticResource AccentBrush}" Text="{Binding SourceBadge}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource FaintTextBrush}"
                                   Text="System fonts are installed in Windows; ◆ marks a file from the configured custom font folder." />
                    </StackPanel>

                    <StackPanel x:Name="TextPlacementFields" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="FontSizeField">
                                <TextBlock Margin="0,0,0,4" Text="Font size" />
                                <controls:NumericEditorControl x:Name="FontSizeEditor"
                                                               Minimum="8" Maximum="120" Step="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Position preset (resets transform)" />
                                <ComboBox x:Name="PositionComboBox"
                                          SelectionChanged="PositionComboBox_SelectionChanged" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Margin="0,10,0,4" Text="Preview transform" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="X center (%)" />
                                <controls:NumericEditorControl x:Name="OverlayXEditor"
                                                               Minimum="0" Maximum="100" Step="1"
                                                               Edited="TransformEditor_Edited" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Y center (%)" />
                                <controls:NumericEditorControl x:Name="OverlayYEditor"
                                                               Minimum="0" Maximum="100" Step="1"
                                                               Edited="TransformEditor_Edited" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,4" Text="Scale (%)" />
                                <controls:NumericEditorControl x:Name="OverlayScaleEditor"
                                                               Minimum="5" Maximum="400" Step="5"
                                                               Edited="TransformEditor_Edited" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Margin="0,0,0,4" Text="Rotation (°)" />
                                <controls:NumericEditorControl x:Name="OverlayRotationEditor"
                                                               Minimum="-180" Maximum="180" Step="1"
                                                               Edited="TransformEditor_Edited" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <controls:TimeRangeEditorControl x:Name="TimeRangeEditor" Margin="0,0,0,10" />
                    <TextBlock x:Name="SnapDescriptionText" Margin="0,-5,0,10" FontSize="10"
                               Foreground="{StaticResource FaintTextBrush}" />

                    <StackPanel x:Name="OverlayFadeFields" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Fade in to visible (seconds)" />
                                <controls:NumericEditorControl x:Name="OverlayFadeInEditor" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Fade out to transparent (seconds)" />
                                <controls:NumericEditorControl x:Name="OverlayFadeOutEditor" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AudioFields" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Volume" />
                                <controls:NumericEditorControl x:Name="VolumeEditor"
                                                               Minimum="0" Maximum="2" Step="0.05" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Fade in (seconds)" />
                                <controls:NumericEditorControl x:Name="FadeInEditor" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,4" Text="Fade out (seconds)" />
                                <controls:NumericEditorControl x:Name="FadeOutEditor" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ProgressFields">
                        <TextBlock Margin="0,0,0,4" Text="Timing" />
                        <ComboBox x:Name="ProgressTimingComboBox" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Style" />
                                <ComboBox x:Name="ProgressStyleComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Screen position" />
                                <ComboBox x:Name="ProgressPositionComboBox" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Color (#RRGGBB)" />
                                <TextBox x:Name="ProgressColorTextBox" Text="#C8C0B2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Height (pixels)" />
                                <controls:NumericEditorControl x:Name="ProgressHeightEditor"
                                                               Minimum="2" Maximum="50" Step="1" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="80" IsCancel="True" Content="Cancel" />
            <Button x:Name="AddButton" MinWidth="90" Margin="5,0,0,0" Click="Add_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Content="Add" />
        </StackPanel>
    </Grid>
</Window>
