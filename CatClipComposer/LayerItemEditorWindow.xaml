<Window x:Class="CatClipComposer.LayerItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Layer item" Width="650" Height="680" MinWidth="560" MinHeight="520"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="14" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
        <Border Grid.Row="1" Margin="0,10,0,0" Padding="12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="SourceFields" Margin="0,0,0,10">
                        <TextBlock x:Name="SourceLabel" Margin="0,0,0,4" Text="Source file" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceTextBox" />
                            <Button Grid.Column="1" Margin="5,0,0,0" Click="Browse_Click" Content="Browse…" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="TextFields" Margin="0,0,0,10">
                        <TextBlock Margin="0,0,0,4" Text="Text" />
                        <TextBox x:Name="OverlayTextBox" Height="70" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <StackPanel x:Name="FontFields" Margin="0,0,0,10">
                        <TextBlock Margin="0,0,0,4" Text="Font" />
                        <ComboBox x:Name="FontComboBox">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Details}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock FontFamily="{Binding PreviewFontFamily}" Text="{Binding FamilyName}" />
                                        <TextBlock Grid.Column="1" Margin="12,0,0,0" FontSize="9"
                                                   Foreground="{StaticResource AccentBrush}" Text="{Binding SourceBadge}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource FaintTextBrush}"
                                   Text="System fonts are installed in Windows; ◆ marks a file from the configured custom font folder." />
                    </StackPanel>

                    <StackPanel x:Name="TextPlacementFields" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Font size" />
                                <TextBox x:Name="FontSizeTextBox" Text="42" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Position" />
                                <ComboBox x:Name="PositionComboBox" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Text="Start (seconds)" />
                            <TextBox x:Name="StartTextBox" Text="0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,4" Text="Duration (seconds)" />
                            <TextBox x:Name="DurationTextBox" Text="5" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SnapDescriptionText" Margin="0,-5,0,10" FontSize="10"
                               Foreground="{StaticResource FaintTextBrush}" />

                    <StackPanel x:Name="AudioFields" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Volume (0–4)" />
                                <TextBox x:Name="VolumeTextBox" Text="0.35" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Fade in (seconds)" />
                                <TextBox x:Name="FadeInTextBox" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,4" Text="Fade out (seconds)" />
                                <TextBox x:Name="FadeOutTextBox" Text="0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ProgressFields">
                        <TextBlock Margin="0,0,0,4" Text="Timing" />
                        <ComboBox x:Name="ProgressTimingComboBox" Margin="0,0,0,10" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Style" />
                                <ComboBox x:Name="ProgressStyleComboBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Screen position" />
                                <ComboBox x:Name="ProgressPositionComboBox" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="Color (#RRGGBB)" />
                                <TextBox x:Name="ProgressColorTextBox" Text="#C8C0B2" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="Height (pixels)" />
                                <TextBox x:Name="ProgressHeightTextBox" Text="10" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="80" IsCancel="True" Content="Cancel" />
            <Button x:Name="AddButton" MinWidth="90" Margin="5,0,0,0" Click="Add_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Content="Add" />
        </StackPanel>
    </Grid>
</Window>
