<Window x:Class="CatClipComposer.BulkTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit clip tags"
        Width="520" Height="310" MinWidth="420" MinHeight="270"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="SummaryText" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,5,0,8"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Comma-separated tags replace the tags on every selected clip." />
        <StackPanel Grid.Row="2" Margin="0,0,0,7">
            <TextBlock Margin="0,0,0,5" FontSize="10" FontWeight="SemiBold"
                       Foreground="{StaticResource MutedTextBrush}" Text="10 MOST USED LIBRARY TAGS" />
            <WrapPanel x:Name="PopularTagsPanel" />
        </StackPanel>
        <TextBox x:Name="TagsTextBox" Grid.Row="3" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button IsDefault="True" Click="Save_Click" Content="Save tags" />
            <Button Margin="6,0,0,0" IsCancel="True" Content="Cancel" />
        </StackPanel>
    </Grid>
</Window>
