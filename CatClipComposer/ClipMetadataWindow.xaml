<Window x:Class="CatClipComposer.ClipMetadataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip metadata"
        Width="660"
        Height="480"
        MinWidth="520"
        MinHeight="360"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding FileName}" />
        <TextBlock Grid.Row="1"
                   Margin="0,3,0,10"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding FullPath}"
                   Text="{Binding FullPath}" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Tags" />
            <TextBox x:Name="TagsTextBox"
                     Grid.Column="1"
                     ToolTip="Separate tags with commas or semicolons"
                     Text="{Binding Media.Tags, Mode=OneTime}" />
        </Grid>

        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Margin="8,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Text="COMPLETED PROJECT USAGE" />
                <ListBox x:Name="UsageListBox" Grid.Row="1">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="7,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding ExportedUtc, StringFormat={}{0:g}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding ProjectName}" />
                                    <TextBlock Margin="0,2,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OutputPath}"
                                               Text="{Binding OutputPath}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="UsageStatusText"
                           Grid.Row="1"
                           Margin="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="Loading completed exports…" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="80" IsCancel="True" Content="Cancel" />
            <Button MinWidth="90"
                    Margin="6,0,0,0"
                    Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="Save tags" />
        </StackPanel>
    </Grid>
</Window>
