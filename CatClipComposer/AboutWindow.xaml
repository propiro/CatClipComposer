<Window x:Class="CatClipComposer.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Cat Clip Composer"
        Width="820" Height="600"
        MinWidth="720" MinHeight="520"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource PreviewBrush}"
                BorderBrush="{StaticResource StrongBorderBrush}"
                BorderThickness="1">
            <Grid>
                <Image Source="pack://application:,,,/Assets/mr-cat-bee-splash.png"
                       Stretch="UniformToFill" />
                <Border VerticalAlignment="Bottom" Padding="9,7" Background="#D9141413">
                    <TextBlock HorizontalAlignment="Center" FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Mr. Cat — splash-screen supervisor" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="CAT CLIP COMPOSER" />
                <TextBlock x:Name="VersionText" Margin="0,2,0,0" FontFamily="Consolas"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="RevisionText" Margin="0,2,0,12" FontFamily="Consolas" FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="Cat Clip Composer is ENTIRELY vibecoded." />
                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                           Text="This is an experiment to see how good (or bad!) vibecoding without manually touching code can get. It is a Windows timeline editor built with .NET 8/WPF and uses the separately packaged FFmpeg tools for media processing." />
            </StackPanel>

            <Border Grid.Row="1" Margin="0,16,0,10" Padding="10"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                    Background="{StaticResource PanelBrush}">
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="CHECK FOR UPDATES" />
                    <TextBlock Margin="0,4,0,8" FontSize="10" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="Manual check only. It reads the public GitHub Release and repository metadata; it does not download, install, or send credentials." />
                    <ProgressBar x:Name="UpdateProgressBar" Height="8" Margin="0,0,0,8"
                                 IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap"
                               Text="Press Check for updates to compare this build with GitHub." />
                    <TextBlock x:Name="UpdateWarningText" Margin="0,6,0,0" FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="CheckForUpdatesButton" Click="CheckForUpdates_Click"
                                Content="Check for updates" />
                        <Button x:Name="OpenLatestReleaseButton" Margin="5,0,0,0"
                                Click="OpenLatestRelease_Click" Content="Open latest download"
                                Visibility="Collapsed" />
                        <Button Margin="5,0,0,0" Click="OpenRepository_Click"
                                Content="Open repository" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="Details" />
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="Portable configuration is kept beside the executable. The default package includes an external LGPL-compatible FFmpeg distribution, source/license records, the CLI, built-in plugins, documentation, and this photo of Mr. Cat." />
                    <TextBlock Margin="0,10,0,0" FontWeight="SemiBold" Text="Project" />
                    <TextBlock Margin="0,5,0,0" TextWrapping="Wrap"
                               Text="Public source and downloadable Windows releases are hosted at github.com/propiro/CatClipComposer." />
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="3" Margin="0,12,0,0" MinWidth="84"
                    HorizontalAlignment="Right" IsCancel="True" Content="Close" />
        </Grid>
    </Grid>
</Window>
