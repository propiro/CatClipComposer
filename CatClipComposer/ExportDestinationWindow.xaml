<Window x:Class="CatClipComposer.ExportDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose export destination"
        Width="780"
        Height="610"
        MinWidth="620"
        MinHeight="480"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,12">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Export compilation" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Choose a folder and file name inside Cat Clip Composer. No Windows file picker is used." />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,7,0" VerticalAlignment="Center" Text="Drive" />
            <ComboBox x:Name="DriveComboBox"
                      Grid.Column="1"
                      SelectionChanged="DriveComboBox_SelectionChanged"
                      ToolTip="Jump to an available drive." />
            <Button Grid.Column="2" Margin="7,0,7,0" Click="Up_Click" Content="UP"
                    ToolTip="Go to the parent folder." />
            <TextBox x:Name="PathTextBox" Grid.Column="3"
                     TextChanged="PathTextBox_TextChanged"
                     KeyDown="PathTextBox_KeyDown"
                     ToolTip="Type an existing directory and press Enter or GO." />
            <Button Grid.Column="4" Margin="7,0,0,0" Click="Go_Click" Content="GO"
                    ToolTip="Open the directory typed in the path field." />
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource InputBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <ListBox x:Name="FolderListBox"
                     BorderThickness="0"
                     Background="Transparent"
                     MouseDoubleClick="FolderListBox_MouseDoubleClick"
                     ToolTip="Double-click a folder to open it. The path above is the export directory.">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" FontSize="16" Text="▸" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock FontSize="10" Foreground="{StaticResource FaintTextBrush}"
                                           Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="New folder" />
            <TextBox x:Name="NewFolderTextBox" Grid.Column="1"
                     ToolTip="Enter a new directory name inside the current folder." />
            <Button Grid.Column="2" Margin="7,0,0,0" Click="CreateFolder_Click" Content="CREATE"
                    ToolTip="Create and enter the named directory." />

            <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="File name" />
            <TextBox x:Name="FileNameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                     Margin="0,8,0,0" TextChanged="FileNameTextBox_TextChanged"
                     ToolTip="Name the MP4 file. The .mp4 extension is added automatically." />

            <TextBlock x:Name="OutputPathTextBlock" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                       Margin="0,6,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap" />
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" MinWidth="95" Margin="8,0,0,0"
                    IsCancel="True" Content="CANCEL" />
            <Button DockPanel.Dock="Right" MinWidth="120"
                    Click="Export_Click" Style="{StaticResource PrimaryButtonStyle}" Content="EXPORT"
                    ToolTip="Use this directory and file name, then open the detailed export progress window." />
            <CheckBox x:Name="ReplaceExistingCheckBox"
                      Margin="0,0,10,0"
                      VerticalAlignment="Center"
                      Foreground="{StaticResource DangerBrush}"
                      Visibility="Collapsed"
                      Content="Replace the existing file"
                      ToolTip="Explicitly permit this export to replace the file at the displayed path." />
            <TextBlock x:Name="StatusTextBlock"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource DangerBrush}"
                       TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
