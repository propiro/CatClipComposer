<Window x:Class="CatClipComposer.TrackEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add timeline" Width="430" Height="235"
        MinWidth="400" MinHeight="220" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Add timeline" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"
                       Text="Choose the media/effect role for the new lane." />
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="38" />
            </Grid.RowDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Timeline type" />
            <ComboBox x:Name="TrackKindComboBox" Grid.Column="1"
                      SelectionChanged="TrackKindComboBox_SelectionChanged" />
            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Name" />
            <TextBox x:Name="TrackNameTextBox" Grid.Row="1" Grid.Column="1" />
        </Grid>
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="80" IsCancel="True" Content="Cancel" />
            <Button MinWidth="100" Margin="5,0,0,0" Click="Add_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Content="Add timeline" />
        </StackPanel>
    </Grid>
</Window>
