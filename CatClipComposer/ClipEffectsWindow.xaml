<Window x:Class="CatClipComposer.ClipEffectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clip effects"
        Width="500"
        Height="360"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" />
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Sizing / background" />
                <ComboBox x:Name="FitModeComboBox" Grid.Column="1" />
                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Fade in (seconds)" />
                <TextBox x:Name="FadeInTextBox" Grid.Row="1" Grid.Column="1" />
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Fade out (seconds)" />
                <TextBox x:Name="FadeOutTextBox" Grid.Row="2" Grid.Column="1" />
                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Source volume (0–4)" />
                <TextBox x:Name="VolumeTextBox" Grid.Row="3" Grid.Column="1" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="80" IsCancel="True" Content="Cancel" />
            <Button MinWidth="90" Margin="6,0,0,0" Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Content="Apply" />
        </StackPanel>
    </Grid>
</Window>
