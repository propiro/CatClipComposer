<Window x:Class="CatClipComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Clip Composer"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="CAT CLIP COMPOSER" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SourceSummary}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="1"
                        Height="24"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BorderBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewProject_Click" Content="New" />
                    <Button Margin="4,0,0,0" Click="OpenProject_Click" Content="Open" />
                    <Button Margin="4,0,0,0" Click="SaveProject_Click" Content="Save" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding ProjectName}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,4,0" Click="History_Click" Content="History" />
                    <Button Margin="0,0,4,0" Click="Options_Click" Content="Preferences" />
                    <Button Margin="0,0,4,0" Click="Scan_Click" Content="Rescan library" />
                    <Button Click="Export_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Export" />
                    <Button Margin="4,0,0,0"
                            Click="CancelScan_Click"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="4" />
                <RowDefinition Height="270" MinHeight="150" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="190" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="270" MinWidth="190" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
            <GridSplitter Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" />
            <GridSplitter Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="5"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border x:Name="ContentBrowserPanel" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition x:Name="BrowserBodyRow" Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="CONTENT BROWSER" />
                            <Button x:Name="BrowserExpandButton"
                                    Grid.Column="1"
                                    Margin="0,0,2,0"
                                    Click="BrowserExpand_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    ToolTip="Collapse or expand the browser"
                                    Content="-" />
                            <Button Grid.Column="2"
                                    Tag="ContentBrowser"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid x:Name="BrowserBody" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="23" />
                        </Grid.RowDefinitions>
                        <Grid Margin="6,5,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox VerticalContentAlignment="Center"
                                     ToolTip="Filter by name or path"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Click="Scan_Click"
                                    Content="Refresh" />
                        </Grid>
                        <ListBox x:Name="CatalogListBox"
                                 Grid.Row="1"
                                 Margin="4,0"
                                 ItemsSource="{Binding MediaView}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 SelectionChanged="CatalogListBox_SelectionChanged"
                                 PreviewMouseLeftButtonDown="CatalogListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="CatalogListBox_PreviewMouseMove"
                                 MouseDoubleClick="CatalogListBox_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="58">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource PreviewBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           Text="NO PREVIEW" />
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="3,1"
                                                        Background="#CC151513">
                                                    <TextBlock FontSize="9" Text="{Binding Index, StringFormat=# {0}}" />
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Padding="3,1"
                                                        Background="#DD151513">
                                                    <TextBlock FontSize="9" Text="{Binding DurationText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="7,2,2,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}"
                                                       Text="{Binding FileName}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding DimensionsText}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="10"
                                                       Foreground="{StaticResource FaintTextBrush}"
                                                       Text="{Binding UsageText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2"
                                   Margin="7,2,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding CatalogSummary}" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PREVIEW" />
                            <Button Grid.Column="1"
                                    Tag="Preview"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="6"
                            Background="{StaticResource PreviewBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <MediaElement x:Name="PreviewPlayer"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      MediaFailed="PreviewPlayer_MediaFailed" />
                    </Border>
                    <Grid Grid.Row="2" Margin="6,0,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedMedia.FullPath}"
                                           Text="{Binding SelectedMedia.FileName}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding SelectedMedia.DimensionsText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="AddSelected_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Add clip" />
                        </Grid>
                        <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                            <Button Click="PreviewPlay_Click" Content="Play" />
                            <Button Margin="4,0,0,0" Click="PreviewPause_Click" Content="Pause" />
                            <Button Margin="4,0,0,0" Click="OpenSource_Click" Content="Show file" />
                            <Button Margin="4,0,0,0" Click="OpenLastOutput_Click" Content="Last export" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LayersPanel" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="56" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="LAYERS / USED CLIPS" />
                            <Button Grid.Column="1"
                                    Tag="Layers"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="7,6,7,3">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="10" FontWeight="SemiBold" Text="VIDEO TRACK" />
                        <TextBlock Grid.Row="1"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Timeline.TotalText}" />
                    </Grid>
                    <ListBox Grid.Row="2"
                             Margin="4,0"
                             ItemsSource="{Binding Timeline.Clips}"
                             SelectedItem="{Binding Timeline.SelectedClip}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="42">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{StaticResource PreviewBrush}">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="6,2,2,0">
                                        <TextBlock FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding FileName}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="9"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding KindText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Margin="4,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource AccentBrush}"
                                               Text="{Binding DurationText}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="6" Orientation="Horizontal">
                        <Button Click="AddStillScreen_Click" Content="Add image" />
                        <Button Margin="4,0,0,0" IsEnabled="False" Content="Add text" />
                        <Button Margin="4,0,0,0" Click="RemoveTimeline_Click" Content="Remove" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="TimelinePanel" Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PROJECT TIMELINE" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding Timeline.TotalText}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Timeline.RemainingText}" />
                            <Button Grid.Column="4" Click="MoveLeft_Click" Style="{StaticResource HeaderButtonStyle}" Content="Move left" />
                            <Button Grid.Column="5" Click="MoveRight_Click" Style="{StaticResource HeaderButtonStyle}" Content="Move right" />
                            <Button Grid.Column="6" Click="RemoveTimeline_Click" Style="{StaticResource HeaderButtonStyle}" Content="Remove" />
                            <Button Grid.Column="7" Click="ClearTimeline_Click" Style="{StaticResource HeaderButtonStyle}" Content="Clear" />
                            <Button Grid.Column="8"
                                    Tag="Timeline"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="7,5,7,3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="13" />
                            <RowDefinition Height="17" />
                        </Grid.RowDefinitions>
                        <ProgressBar Height="10"
                                     Maximum="100"
                                     Value="{Binding Timeline.Progress, Mode=OneWay}" />
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisStartText}" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisQuarterText}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisHalfText}" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisThreeQuarterText}" />
                            <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisEndText}" />
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="6,0,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource ToolbarBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1,1,0,1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="VIDEO" />
                                <TextBlock HorizontalAlignment="Center" FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="V1" />
                            </StackPanel>
                        </Border>
                        <ListBox x:Name="TimelineListBox"
                                 Grid.Column="1"
                                 AllowDrop="True"
                                 ItemsSource="{Binding Timeline.Clips}"
                                 SelectedItem="{Binding Timeline.SelectedClip}"
                                 DragOver="TimelineListBox_DragOver"
                                 Drop="TimelineListBox_Drop"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 KeyDown="TimelineListBox_KeyDown">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Margin" Value="0,0,3,0" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding CardWidth}"
                                            MinWidth="100"
                                            Height="108"
                                            Background="{StaticResource CardBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="62" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid Background="{StaticResource PreviewBrush}">
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="3,1"
                                                        Background="#DD151513">
                                                    <TextBlock FontSize="9" FontWeight="SemiBold" Text="{Binding Order, StringFormat=# {0}}" />
                                                </Border>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="5,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock FontSize="9"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding FileName}"
                                                               Text="{Binding FileName}" />
                                                    <TextBlock Margin="0,2,0,0"
                                                               FontSize="8"
                                                               Foreground="{StaticResource FaintTextBrush}"
                                                               Text="{Binding KindText}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Margin="4,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="9"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Text="{Binding DurationText}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="7,0">
            <ProgressBar Height="2"
                         VerticalAlignment="Top"
                         Maximum="100"
                         Value="{Binding ScanProgress, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="10"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</Window>
