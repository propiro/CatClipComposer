<Window x:Class="CatClipComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CatClipComposer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Title="{Binding WindowTitle}"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="CAT CLIP COMPOSER" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SourceSummary}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="1"
                        Height="24"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BorderBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewProject_Click" Content="New" />
                    <Button Margin="4,0,0,0" Click="OpenProject_Click" Content="Open" />
                    <Button Margin="4,0,0,0" Click="SaveProject_Click" Content="Save" />
                    <Button Margin="4,0,0,0" Click="OutputSettings_Click" Content="Project settings" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding ProjectName}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,4,0" Click="History_Click" Content="History" />
                    <Button Margin="0,0,4,0" Click="Options_Click" Content="Preferences" />
                    <Button Margin="0,0,4,0" Click="Scan_Click" Content="Rescan library" />
                    <Button Click="Export_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Export" />
                    <Button Margin="4,0,0,0"
                            Click="CancelScan_Click"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="4" />
                <RowDefinition Height="270" MinHeight="150" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="190" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="270" MinWidth="190" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
            <GridSplitter Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" />
            <GridSplitter Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="5"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border x:Name="ContentBrowserPanel"
                    Tag="ContentBrowser"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BrowserExpandButton"
                                    Grid.Column="0"
                                    Width="24"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    FontSize="14"
                                    Click="BrowserExpand_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    AutomationProperties.Name="Expand content browser"
                                    ToolTip="Expand content browser to full workspace width"
                                    Content="→" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource PanelTitleStyle}"
                                       Text="CONTENT BROWSER" />
                            <Button Grid.Column="2"
                                    Tag="ContentBrowser"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="23" />
                        </Grid.RowDefinitions>
                        <Grid Margin="6,5,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox VerticalContentAlignment="Center"
                                     ToolTip="Filter by name or path"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Click="Scan_Click"
                                    Content="Refresh" />
                        </Grid>
                        <ListBox x:Name="CatalogListBox"
                                 Grid.Row="1"
                                 Margin="4,0"
                                 ItemsSource="{Binding MediaView}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 SelectionChanged="CatalogListBox_SelectionChanged"
                                 PreviewMouseLeftButtonDown="CatalogListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="CatalogListBox_PreviewMouseMove"
                                 MouseDoubleClick="CatalogListBox_MouseDoubleClick"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ItemWidth="142" ItemHeight="136" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Width" Value="136" />
                                    <Setter Property="Height" Value="130" />
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="78" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource PreviewBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           Text="NO PREVIEW" />
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="3,1"
                                                        Background="#CC151513">
                                                    <TextBlock FontSize="10" Text="{Binding Index, StringFormat=# {0}}" />
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Padding="3,1"
                                                        Background="#DD151513">
                                                    <TextBlock FontSize="10" Text="{Binding DurationText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="3,5,2,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}"
                                                       Text="{Binding FileName}" />
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Left" FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DimensionsText}" />
                                                <TextBlock Margin="8,0,0,0" FontSize="10"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TagsText}" Text="{Binding TagsText}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2"
                                   Margin="7,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding CatalogSummary}" />
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,4,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PREVIEW" />
                            <Button Grid.Column="1"
                                    Tag="Preview"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Border Grid.Row="1"
                            Margin="6"
                            Background="{StaticResource PreviewBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="48" />
                            </Grid.RowDefinitions>
                            <MediaElement x:Name="PreviewPlayer"
                                          LoadedBehavior="Manual"
                                          UnloadedBehavior="Stop"
                                          IsMuted="True"
                                          Volume="0.5"
                                          ScrubbingEnabled="True"
                                          Stretch="Uniform"
                                          MediaOpened="PreviewPlayer_MediaOpened"
                                          MediaEnded="PreviewPlayer_MediaEnded"
                                          MediaFailed="PreviewPlayer_MediaFailed" />
                            <Border Grid.Row="1"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,1,0,0"
                                    Background="{StaticResource InputBrush}">
                                <Image Source="{Binding SelectedMedia.PreviewSheetPath}"
                                       Stretch="Uniform" />
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="6,0,6,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedMedia.FullPath}"
                                           Text="{Binding SelectedMedia.FileName}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="{Binding SelectedMedia.DimensionsText}" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Click="AddSelected_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="Add clip" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PreviewPositionText" Width="43" VerticalAlignment="Center"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="0:00" />
                            <Slider x:Name="PreviewSeekSlider" Grid.Column="1" Margin="5,0"
                                    Minimum="0" Maximum="1" Value="0"
                                    PreviewMouseLeftButtonDown="PreviewSeekSlider_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="PreviewSeekSlider_PreviewMouseLeftButtonUp" />
                            <TextBlock x:Name="PreviewDurationText" Grid.Column="2" Width="43"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextAlignment="Right" FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}" Text="0:00" />
                        </Grid>
                        <WrapPanel Grid.Row="2" Margin="0,5,0,0">
                            <Button Click="PreviewPlay_Click" Content="Play" />
                            <Button Margin="4,0,0,0" Click="PreviewPause_Click" Content="Pause" />
                            <Button x:Name="PreviewMuteButton" Margin="4,0,0,0"
                                    Click="PreviewMute_Click" Content="Unmute" ToolTip="Preview starts muted" />
                            <TextBlock Margin="8,0,4,0" VerticalAlignment="Center"
                                       FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="Volume" />
                            <Slider x:Name="PreviewVolumeSlider" Width="72" Minimum="0" Maximum="1" Value="0.5"
                                    VerticalAlignment="Center" ValueChanged="PreviewVolumeSlider_ValueChanged" />
                            <Button Margin="4,0,0,0" Click="OpenSource_Click" Content="Show file" />
                            <Button Margin="4,0,0,0" Click="OpenLastOutput_Click" Content="Last export" />
                            <Button Margin="4,0,0,0" Click="ClipMetadata_Click" Content="Metadata" />
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LayersPanel"
                    Tag="Layers"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="LAYERS / USED CLIPS" />
                            <Button Grid.Column="1"
                                    Tag="Layers"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Expander Grid.Row="1" Margin="6,5,6,3" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="PROJECT SETTINGS" />
                        </Expander.Header>
                        <Border Margin="0,4,0,2" Padding="7"
                                Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Text="{Binding ProjectName}" />
                                <TextBlock Margin="0,3,0,0" FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap" Text="{Binding ProjectSettingsSummary}" />
                                <TextBlock Margin="0,2,0,5" FontSize="10"
                                           Foreground="{StaticResource FaintTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding ProjectFilePath}"
                                           Text="{Binding ProjectFilePath, TargetNullValue=Not saved yet}" />
                                <Button HorizontalAlignment="Left" Click="OutputSettings_Click"
                                        Content="Edit project settings…" />
                            </StackPanel>
                        </Border>
                    </Expander>
                    <Grid Grid.Row="2" Margin="7,6,7,3">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="PROJECT TRACKS" />
                        <TextBlock Grid.Row="1"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Timeline.TotalText}" />
                    </Grid>
                    <ListBox Grid.Row="3"
                             Margin="4,0"
                             ItemsSource="{Binding ProjectLayers}"
                             SelectedItem="{Binding SelectedProjectLayer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="LayerRow" Padding="7,4" BorderThickness="0,0,0,1"
                                        BorderBrush="{StaticResource BorderBrush}">
                                    <StackPanel>
                                        <TextBlock x:Name="LayerTitle"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Title}" />
                                        <TextBlock x:Name="LayerDetail"
                                                   Margin="0,2,0,0"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Detail}" />
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsTrackHeader}" Value="True">
                                        <Setter TargetName="LayerRow" Property="Background" Value="{StaticResource ToolbarBrush}" />
                                        <Setter TargetName="LayerTitle" Property="Foreground" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="LayerDetail" Property="Foreground" Value="{StaticResource FaintTextBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Grid.Row="4" Margin="6">
                        <Button Click="AddTrack_Click" Content="+ Track" />
                        <Button Margin="4,0,0,0" Click="RemoveTrack_Click" Content="- Track" />
                        <Button Margin="4,0,0,0" Click="AddPluginEffect_Click" Content="+ Effect" />
                        <Button Tag="Text" Margin="4,0,0,0" Click="AddLayer_Click" Content="+ Text" />
                        <Button Tag="Image" Margin="4,0,0,0" Click="AddLayer_Click" Content="+ PNG" />
                        <Button Tag="Audio" Margin="4,0,0,0" Click="AddLayer_Click" Content="+ Music" />
                        <Button Tag="Progress" Margin="4,0,0,0" Click="AddLayer_Click" Content="+ Progress" />
                        <Button Margin="4,0,0,0" Click="EditLayer_Click" Content="Edit" />
                        <Button Margin="4,0,0,0" Click="ClipEffects_Click" Content="Clip FX" />
                        <Button Margin="4,0,0,0" Click="RemoveLayer_Click" Content="Remove" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="TimelinePanel"
                    Tag="Timeline"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Margin="0,4,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PROJECT TIMELINE" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding Timeline.TotalText}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Timeline.RemainingText}" />
                            <Button Grid.Column="4" Click="ClearTimeline_Click" Style="{StaticResource HeaderButtonStyle}" Content="Clear" />
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Click="FitTimelineHorizontally_Click" Style="{StaticResource HeaderButtonStyle}"
                                        Content="Fit horizontal" ToolTip="Fit the project duration into the visible width" />
                                <Button Margin="3,0,4,0" Click="FitTimelineVertically_Click" Style="{StaticResource HeaderButtonStyle}"
                                        Content="Fit vertical" ToolTip="Fit all timelines into the visible height" />
                            </StackPanel>
                            <Button Grid.Column="5"
                                    Tag="Timeline"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="7,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="TimelineRulerMode_Click" Content="{Binding Timeline.RulerModeButtonText}" />
                        <Button Grid.Column="1" Margin="4,0,0,0" Click="TimelineSnapMode_Click"
                                Content="{Binding Timeline.SnapModeButtonText}" />
                        <TextBlock Grid.Column="2" Margin="9,0,4,0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="Time zoom" />
                        <Slider Grid.Column="3" Minimum="0.1" Maximum="40"
                                Value="{Binding Timeline.PixelsPerSecond, Mode=TwoWay}" />
                        <TextBlock Grid.Column="4" Margin="9,0,4,0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="Track height" />
                        <Slider Grid.Column="5" Minimum="28" Maximum="110"
                                Value="{Binding Timeline.TrackHeight, Mode=TwoWay}" />
                        <ProgressBar Grid.Column="6" Height="7" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Maximum="100" Value="{Binding Timeline.Progress, Mode=OneWay}" />
                    </Grid>

                    <Grid x:Name="TimelineDropSurface" Grid.Row="2" Margin="6,0,6,6"
                          AllowDrop="True" Focusable="True"
                          DragOver="TimelineListBox_DragOver" Drop="TimelineListBox_Drop"
                          KeyDown="TimelineListBox_KeyDown">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Height="34" Background="{StaticResource ToolbarBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,1">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="TRACK" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TimelineLanes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Background="{StaticResource ToolbarBrush}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,1">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="9"
                                                                   Foreground="{StaticResource FaintTextBrush}" Text="{Binding ShortName}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Width="{Binding Timeline.TimelineWidth}">
                                        <Border Height="34" Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <ItemsControl Width="{Binding Timeline.TimelineWidth}"
                                                          Height="32" ItemsSource="{Binding Timeline.RulerTicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Bottom" Value="0" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="105" Height="32">
                                                            <Border Width="1" Height="{Binding TickHeight}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                    Background="{StaticResource StrongBorderBrush}" />
                                                            <TextBlock Margin="3,1,0,0" FontSize="9"
                                                                       Foreground="{StaticResource MutedTextBrush}" Text="{Binding Label}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding TimelineLanes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Tag="{Binding TrackId}" AllowDrop="True"
                                                            DragOver="TimelineLane_DragOver" Drop="TimelineLane_Drop"
                                                            Background="#191918" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1,0,1,1">
                                                        <ItemsControl Width="{Binding DataContext.Timeline.TimelineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                    <Setter Property="Canvas.Top" Value="2" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="TimelineItemBorder"
                                                                            Width="{Binding Width}" Height="{Binding Height}"
                                                                            Padding="4" Background="{Binding Background}"
                                                                            BorderBrush="{StaticResource StrongBorderBrush}"
                                                                            BorderThickness="1" Tag="{Binding}"
                                                                            ToolTip="{Binding Title}"
                                                                            PreviewMouseLeftButtonDown="TimelineLaneItem_PreviewMouseLeftButtonDown"
                                                                            PreviewMouseMove="TimelineLaneItem_PreviewMouseMove">
                                                                        <Grid ClipToBounds="True">
                                                                            <Image Opacity="0.34" Source="{Binding ThumbnailPath}"
                                                                                   Stretch="UniformToFill"
                                                                                   Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Grid>
                                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                                                <WrapPanel Visibility="{Binding ShowClipActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Button Padding="4,1" MinHeight="20" Click="MoveLeft_Click" Content="←" ToolTip="Move clip left" />
                                                                                    <Button Margin="2,0,0,0" Padding="4,1" MinHeight="20" Click="MoveRight_Click" Content="→" ToolTip="Move clip right" />
                                                                                    <Button Margin="2,0,0,0" Padding="4,1" MinHeight="20" Click="RemoveTimeline_Click" Content="×" ToolTip="Remove clip" />
                                                                                </WrapPanel>
                                                                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                                                    <TextBlock Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                                                                               TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Grid>
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                            <Setter TargetName="TimelineItemBorder" Property="BorderThickness" Value="2" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="7,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="2"
                         Grid.ColumnSpan="2"
                         VerticalAlignment="Top"
                         Maximum="100"
                         Value="{Binding ScanProgress, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusText}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource FaintTextBrush}"
                       Text="{Binding ApplicationVersion}" />
        </Grid>
    </Grid>
</Window>
