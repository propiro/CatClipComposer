<Window x:Class="CatClipComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Clip Composer"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="292" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="23" FontWeight="SemiBold" Text="Cat Clip Composer" />
                    <TextBlock Margin="0,3,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SourceSummary}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,8,0" Click="History_Click" Content="History" />
                    <Button Margin="0,0,8,0" Click="Options_Click" Content="Options" />
                    <Button Margin="0,0,8,0"
                            Click="Scan_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Update catalog" />
                    <Button Click="CancelScan_Click"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="600" />
                <ColumnDefinition Width="1*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="20,18,10,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Clip catalog" />
                        <TextBlock Margin="0,3,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding CatalogSummary}" />
                    </StackPanel>
                    <TextBox Grid.Column="2"
                             Height="36"
                             VerticalContentAlignment="Center"
                             ToolTip="Search by file name or path"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListBox x:Name="CatalogListBox"
                             ItemsSource="{Binding MediaView}"
                             SelectedItem="{Binding SelectedMedia}"
                             SelectionChanged="CatalogListBox_SelectionChanged"
                             MouseDoubleClick="CatalogListBox_MouseDoubleClick"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Margin" Value="7" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Width="188"
                                        Height="178"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="5"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="108" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0" Background="#151821">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11"
                                                       Text="NO THUMBNAIL" />
                                            <Image Source="{Binding ThumbnailPath}"
                                                   Stretch="UniformToFill" />
                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="6"
                                                    Padding="6,3"
                                                    Background="#CC171922"
                                                    CornerRadius="3">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Index, StringFormat=# {0}}" />
                                            </Border>
                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Bottom"
                                                    Margin="6"
                                                    Padding="6,3"
                                                    Background="#DD171922"
                                                    CornerRadius="3">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DurationText}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="9,7">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}"
                                                       Visibility="{Binding ShowFileName, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                       Text="{Binding FileName}" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding DimensionsText}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding UsageText}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Border Grid.Column="1"
                    Margin="10,18,20,16"
                    Padding="16"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,12"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Text="Preview" />
                    <Border Grid.Row="1"
                            Background="#090B10"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <MediaElement x:Name="PreviewPlayer"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Stop"
                                      ScrubbingEnabled="True"
                                      Stretch="Uniform"
                                      MediaFailed="PreviewPlayer_MediaFailed" />
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedMedia.FullPath}"
                                   Text="{Binding SelectedMedia.FileName}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding SelectedMedia.DimensionsText}" />
                        <TextBlock Margin="0,2,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding SelectedMedia.UsageText}" />
                    </StackPanel>
                    <WrapPanel Grid.Row="3" Margin="0,12,0,0">
                        <Button Click="PreviewPlay_Click" Content="Play" />
                        <Button Margin="7,0,0,0" Click="PreviewPause_Click" Content="Pause" />
                        <Button Margin="7,0,0,0" Click="OpenSource_Click" Content="Show file" />
                        <Button Margin="7,0,0,0" Click="OpenLastOutput_Click" Content="Last output" />
                        <Button Margin="7,0,0,0"
                                Click="AddSelected_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Add to timeline" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="20,0,20,14"
                Padding="16,14"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Compilation timeline" />
                        <TextBlock Margin="14,4,0,0"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding Timeline.TotalText}" />
                        <TextBlock Margin="12,4,0,0"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Timeline.RemainingText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Margin="0,0,7,0"
                                Click="Export_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Content="Export MP4…" />
                        <Button Margin="0,0,7,0"
                                Click="AddStillScreen_Click"
                                Content="Add screen…" />
                        <Button Click="MoveLeft_Click" Content="Move left" />
                        <Button Margin="7,0,0,0" Click="MoveRight_Click" Content="Move right" />
                        <Button Margin="7,0,0,0" Click="RemoveTimeline_Click" Content="Remove" />
                        <Button Margin="7,0,0,0" Click="ClearTimeline_Click" Content="Clear" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <ProgressBar Grid.Row="0"
                                 Height="16"
                                 Maximum="100"
                                 Value="{Binding Timeline.Progress, Mode=OneWay}" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisStartText}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisQuarterText}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisHalfText}" />
                        <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisThreeQuarterText}" />
                        <TextBlock Grid.Column="4" HorizontalAlignment="Right" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.AxisEndText}" />
                    </Grid>
                </Grid>

                <ListBox x:Name="TimelineListBox"
                         Grid.Row="2"
                         ItemsSource="{Binding Timeline.Clips}"
                         SelectedItem="{Binding Timeline.SelectedClip}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         KeyDown="TimelineListBox_KeyDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Margin" Value="0,0,8,0" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding CardWidth}"
                                    Height="112"
                                    Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="84" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Background="#151821">
                                        <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="5"
                                                Padding="5,2"
                                                Background="#DD171922"
                                                CornerRadius="2">
                                            <TextBlock FontSize="10"
                                                       FontWeight="Bold"
                                                       Text="{Binding Order, StringFormat=# {0}}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="9" VerticalAlignment="Center">
                                        <TextBlock FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding KindText}" />
                                        <TextBlock FontWeight="SemiBold"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FileName}"
                                                   Text="{Binding FileName}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Text="{Binding DurationText}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="20,0">
            <ProgressBar Height="3"
                         VerticalAlignment="Top"
                         Maximum="100"
                         Value="{Binding ScanProgress, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusText}" />
        </Grid>
    </Grid>
</Window>
