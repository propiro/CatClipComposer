<Window x:Class="CatClipComposer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CatClipComposer.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        Title="{Binding WindowTitle}"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        Closing="MainWindow_Closing"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="CAT CLIP COMPOSER" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding SourceSummary}" />
                </StackPanel>
                <Border Grid.Column="1"
                        Width="1"
                        Height="24"
                        HorizontalAlignment="Center"
                        Background="{StaticResource BorderBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewProject_Click" Content="New" />
                    <Button Margin="4,0,0,0" Click="OpenProject_Click" Content="Open" />
                    <Button Margin="4,0,0,0" Click="SaveProject_Click" Content="Save" />
                    <Button Margin="8,0,0,0" Padding="8,3" Click="Undo_Click" Content="↶"
                            IsEnabled="{Binding CanUndo}" ToolTip="Undo project change (Ctrl+Z)" />
                    <Button Margin="3,0,0,0" Padding="8,3" Click="Redo_Click" Content="↷"
                            IsEnabled="{Binding CanRedo}" ToolTip="Redo project change (Ctrl+Y)" />
                    <Button Margin="4,0,0,0" Click="OutputSettings_Click" Content="Project settings" />
                    <TextBlock Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="{Binding ProjectDisplayName}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Margin="0,0,4,0" Click="History_Click" Content="History" />
                    <Button Margin="0,0,4,0" Click="Options_Click" Content="Preferences" />
                    <Button Margin="0,0,4,0" Click="Scan_Click" Content="Rescan library" />
                    <Button Click="Export_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Content="Export" />
                    <Button Margin="4,0,0,0"
                            Click="CancelScan_Click"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="Cancel" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="220" />
                <RowDefinition Height="4" />
                <RowDefinition Height="270" MinHeight="150" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" MinWidth="190" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="270" MinWidth="190" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
            <GridSplitter Grid.Row="0" Grid.Column="3" HorizontalAlignment="Stretch" />
            <GridSplitter Grid.Row="1"
                          Grid.Column="0"
                          Grid.ColumnSpan="5"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <Border x:Name="ContentBrowserPanel"
                    Tag="ContentBrowser"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BrowserExpandButton"
                                    Grid.Column="0"
                                    Width="24"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    FontSize="14"
                                    Click="BrowserExpand_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    AutomationProperties.Name="Expand content browser"
                                    ToolTip="Expand content browser to full workspace width"
                                    Content="→" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource PanelTitleStyle}"
                                       Text="CONTENT BROWSER" />
                            <Button x:Name="BrowserViewModeButton" Grid.Column="2" Margin="0,0,3,0"
                                    Click="BrowserViewMode_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="{Binding BrowserViewModeText}"
                                    ToolTip="Cycle list, small-grid, and large-grid views" />
                            <Button Grid.Column="3"
                                    Tag="ContentBrowser"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <TabControl Grid.Row="1" Margin="2" Background="{StaticResource PanelBrush}">
                      <TabItem Header="CLIPS">
                       <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="23" />
                        </Grid.RowDefinitions>
                        <Grid Margin="6,5,6,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox VerticalContentAlignment="Center"
                                     ToolTip="Filter by name or path"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Margin="4,0,0,0"
                                    Click="Scan_Click"
                                    Content="Refresh" />
                        </Grid>
                        <ListBox x:Name="CatalogListBox"
                                 Grid.Row="1"
                                 Margin="4,0"
                                 ItemsSource="{Binding MediaView}"
                                 SelectedItem="{Binding SelectedMedia}"
                                 SelectionMode="Extended"
                                 SelectionChanged="CatalogListBox_SelectionChanged"
                                 PreviewMouseLeftButtonDown="CatalogListBox_PreviewMouseLeftButtonDown"
                                 PreviewMouseRightButtonDown="CatalogListBox_PreviewMouseRightButtonDown"
                                 PreviewMouseMove="CatalogListBox_PreviewMouseMove"
                                 ScrollViewer.CanContentScroll="True"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="AddSelectedCatalogItems_Click" Header="Add selected clips to timeline" />
                                    <MenuItem Click="EditSelectedTags_Click" Header="Edit tags for selected clips…" />
                                    <Separator />
                                    <MenuItem Click="OpenSource_Click" Header="Show selected file" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <controls:VirtualizingWrapPanel ItemWidth="{Binding DataContext.BrowserItemWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ItemHeight="{Binding DataContext.BrowserItemHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                        StretchItems="{Binding DataContext.IsBrowserListView, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="Width" Value="{Binding DataContext.BrowserCardWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="Height" Value="{Binding DataContext.BrowserCardHeight, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="Padding" Value="3" />
                                    <Setter Property="Margin" Value="3" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                  <Grid>
                                    <Grid Visibility="{Binding DataContext.IsBrowserGridView, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="{Binding DataContext.BrowserThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{StaticResource PreviewBrush}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           Text="NO PREVIEW" />
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Padding="3,1"
                                                        Background="#CC151513">
                                                    <TextBlock FontSize="10" Text="{Binding Index, StringFormat=# {0}}" />
                                                </Border>
                                                <Border HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Padding="3,1"
                                                        Background="#DD151513">
                                                    <TextBlock FontSize="10" Text="{Binding DurationText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="3,5,2,0">
                                            <TextBlock FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}"
                                                       Text="{Binding FileName}" />
                                            <DockPanel Margin="0,3,0,0">
                                                <TextBlock DockPanel.Dock="Left" FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           Text="{Binding DimensionsText}" />
                                                <TextBlock Margin="8,0,0,0" FontSize="10"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding TagsText}" Text="{Binding TagsText}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Visibility="{Binding DataContext.IsBrowserListView, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Margin="0,0,7,0" Background="{StaticResource PreviewBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <Grid>
                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9"
                                                           Foreground="{StaticResource FaintTextBrush}" Text="NO PREVIEW" />
                                                <Image Source="{Binding ThumbnailPath}" Stretch="UniformToFill" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3,1" Background="#DD151513">
                                                    <TextBlock FontSize="9" Text="{Binding DurationText}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FullPath}" Text="{Binding FileName}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                       Text="{Binding DimensionsText}" />
                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource FaintTextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding TagsText}" Text="{Binding TagsText}" />
                                        </StackPanel>
                                    </Grid>
                                  </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="2"
                                   Margin="7,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding CatalogSummary}" />
                       </Grid>
                      </TabItem>
                      <TabItem Header="EFFECTS">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsControl x:Name="EffectsCatalogItemsControl" Margin="6">
                            <ItemsControl.GroupStyle>
                              <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                  <DataTemplate>
                                    <TextBlock Margin="1,9,0,5" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" Text="{Binding Name}" />
                                  </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                              </GroupStyle>
                            </ItemsControl.GroupStyle>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="7" Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        MouseLeftButtonDown="EffectCatalogEntry_MouseLeftButtonDown">
                                  <Border.ContextMenu>
                                    <ContextMenu>
                                      <MenuItem CommandParameter="{Binding}" Click="EffectCatalogAdd_Click" Header="Add to compatible timeline…" />
                                    </ContextMenu>
                                  </Border.ContextMenu>
                                  <Grid>
                                    <Grid.ColumnDefinitions>
                                      <ColumnDefinition Width="*" />
                                      <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                  <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedTextBrush}" Text="{Binding Description}" />
                                  </StackPanel>
                                    <Button Grid.Column="1" Margin="8,0,0,0" Padding="8,3"
                                            VerticalAlignment="Center" Tag="{Binding}"
                                            Click="EffectCatalogAddButton_Click" Content="Add..." />
                                  </Grid>
                                </Border>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </ScrollViewer>
                      </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border x:Name="PreviewPanel"
                    Tag="Preview"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="0,0,4,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PREVIEW" />
                            <Button x:Name="PreviewLayoutButton"
                                    Grid.Column="1"
                                    Margin="0,0,3,0"
                                    Click="PreviewLayout_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Split"
                                    ToolTip="Show clip and project previews side by side" />
                            <Button Grid.Column="2"
                                    Tag="Preview"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <TabControl x:Name="PreviewTabs" Grid.Row="1" Grid.RowSpan="2" Margin="6">
                        <TabItem x:Name="ClipPreviewTab" Header="CLIP PREVIEW">
                            <ContentControl x:Name="ClipPreviewTabHost">
                            <Grid x:Name="ClipPreviewPane" Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <MediaElement x:Name="PreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                  IsMuted="True" Volume="0.5" ScrubbingEnabled="True" Stretch="Uniform"
                                                  MediaOpened="PreviewPlayer_MediaOpened" MediaEnded="PreviewPlayer_MediaEnded"
                                                  MediaFailed="PreviewPlayer_MediaFailed" />
                                </Border>
                                <Border Grid.Row="1" Background="{StaticResource InputBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,1,1">
                                    <Image Source="{Binding SelectedMedia.PreviewSheetPath}" Stretch="Uniform" />
                                </Border>
                                <Grid Grid.Row="2" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SelectedMedia.FullPath}" Text="{Binding SelectedMedia.FileName}" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding SelectedMedia.DimensionsText}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <Button Click="AddSelected_Click" Style="{StaticResource PrimaryButtonStyle}"
                                                Content="Add this clip" />
                                        <CheckBox x:Name="AutoplayClipsCheckBox" Margin="1,5,0,0"
                                                  HorizontalAlignment="Left" Content="Autoplay clips"
                                                  ToolTip="Automatically play timeline videos opened by double-click" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="PreviewPositionText" Width="43" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}" Text="0:00" />
                                    <Slider x:Name="PreviewSeekSlider" Grid.Column="1" Margin="5,0" Minimum="0" Maximum="1" Value="0"
                                            PreviewMouseLeftButtonDown="PreviewSeekSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="PreviewSeekSlider_PreviewMouseLeftButtonUp" />
                                    <TextBlock x:Name="PreviewDurationText" Grid.Column="2" Width="43" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" TextAlignment="Right" FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}" Text="0:00" />
                                </Grid>
                                <WrapPanel Grid.Row="4" Margin="0,5,0,0">
                                    <Button x:Name="PreviewPlayPauseButton" Click="PreviewPlayPause_Click"
                                            Content="▶" ToolTip="Play clip preview" />
                                    <Button x:Name="PreviewMuteButton" Margin="4,0,0,0" Click="PreviewMute_Click"
                                            FontFamily="Segoe UI Emoji" Content="🔇" ToolTip="Muted — click for sound" />
                                    <Slider x:Name="PreviewVolumeSlider" Width="72" Margin="6,0,0,0" Minimum="0" Maximum="1" Value="0.5"
                                            VerticalAlignment="Center" ValueChanged="PreviewVolumeSlider_ValueChanged" />
                                    <Button Margin="4,0,0,0" Click="OpenSource_Click" Content="Show file" />
                                    <Button Margin="4,0,0,0" Click="ClipMetadata_Click" Content="Metadata" />
                                </WrapPanel>
                            </Grid>
                            </ContentControl>
                        </TabItem>
                        <TabItem x:Name="ProjectPreviewTab" Header="PROJECT PREVIEW">
                            <ContentControl x:Name="ProjectPreviewTabHost">
                            <Grid x:Name="ProjectPreviewPane" Margin="5">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource PreviewBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Grid ClipToBounds="True">
                                        <MediaElement x:Name="ProjectPreviewPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                      IsMuted="True" Volume="0.5" ScrubbingEnabled="True" Stretch="Uniform"
                                                      MediaOpened="ProjectPreviewPlayer_MediaOpened" MediaEnded="ProjectPreviewPlayer_MediaEnded"
                                                      MediaFailed="ProjectPreviewPlayer_MediaFailed" />
                                        <controls:ProjectPreviewOverlayCanvas x:Name="ProjectPreviewOverlayCanvas"
                                                                              OverlaySelected="ProjectPreviewOverlayCanvas_OverlaySelected"
                                                                              OverlayTransformChanged="ProjectPreviewOverlayCanvas_OverlayTransformChanged"
                                                                              OverlayEditAccepted="ProjectPreviewOverlayCanvas_OverlayEditAccepted"
                                                                              OverlayEditCanceled="ProjectPreviewOverlayCanvas_OverlayEditCanceled" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ProjectPreviewPositionText" Width="58" VerticalAlignment="Center" FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}" Text="0:00" />
                                    <Slider x:Name="ProjectPreviewSeekSlider" Grid.Column="1" Margin="5,0" Minimum="0" Maximum="1" Value="0"
                                            PreviewMouseLeftButtonDown="ProjectPreviewSeekSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseLeftButtonUp="ProjectPreviewSeekSlider_PreviewMouseLeftButtonUp" />
                                    <TextBlock x:Name="ProjectPreviewDurationText" Grid.Column="2" Width="58" TextAlignment="Right"
                                               VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="0:00" />
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <WrapPanel VerticalAlignment="Center">
                                        <Button Width="34" Click="ProjectPreviewPreviousFrame_Click" Content="|◀"
                                                ToolTipService.InitialShowDelay="500" ToolTip="Previous frame" />
                                        <Button x:Name="ProjectPreviewPlayPauseButton" Width="58" Margin="4,0,0,0"
                                                Click="ProjectPreviewPlayPause_Click" Content="▶"
                                                ToolTipService.InitialShowDelay="500" ToolTip="Play project preview" />
                                        <Button Width="34" Margin="4,0,0,0" Click="ProjectPreviewNextFrame_Click" Content="▶|"
                                                ToolTipService.InitialShowDelay="500" ToolTip="Next frame" />
                                        <Button x:Name="ProjectPreviewMuteButton" Margin="4,0,0,0" Click="ProjectPreviewMute_Click"
                                                FontFamily="Segoe UI Emoji" Content="🔇" ToolTip="Muted — click for sound" />
                                    </WrapPanel>
                                    <WrapPanel Grid.Column="1" HorizontalAlignment="Center">
                                        <Button Padding="14,5" Click="ProjectPreview_Click"
                                                Style="{StaticResource PrimaryButtonStyle}" Content="PRERENDER PREVIEW"
                                                ToolTip="Prerender the selected timeline range, or the selected frame when there is no range" />
                                        <Button Margin="4,0,0,0" Padding="9,5" Click="PrerenderFrame_Click"
                                                Content="Frame" ToolTip="Prerender only the selected project frame" />
                                        <Button Margin="4,0,0,0" Padding="9,5" Click="PrerenderAll_Click"
                                                Content="All" ToolTip="Prerender the complete project" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ProjectPreviewStatusText" Grid.Column="2" Margin="8,0,0,0"
                                               VerticalAlignment="Center" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                               FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                               Text="Render the current composition." />
                                    <Expander x:Name="ProjectSettingsExpander"
                                              Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                              Margin="0,7,8,0" MaxWidth="380"
                                              HorizontalAlignment="Left" IsExpanded="False"
                                              Style="{StaticResource LayerExpanderStyle}">
                                        <Expander.Header>
                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="PROJECT SETTINGS" />
                                        </Expander.Header>
                                        <Border Margin="22,4,0,0" Padding="7"
                                                Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                           Text="{Binding ProjectName}" />
                                                <TextBlock Margin="0,3,0,0" FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextWrapping="Wrap" Text="{Binding ProjectSettingsSummary}" />
                                                <TextBlock Margin="0,2,0,5" FontSize="10"
                                                           Foreground="{StaticResource FaintTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding ProjectFilePath}"
                                                           Text="{Binding ProjectFilePath, TargetNullValue=Not saved yet}" />
                                                <Button HorizontalAlignment="Left" Click="OutputSettings_Click"
                                                        Content="Edit project settings…" />
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </Grid>
                            </Grid>
                            </ContentControl>
                        </TabItem>
                    </TabControl>
                    <Grid x:Name="PreviewSplitGrid" Grid.Row="1" Grid.RowSpan="2" Margin="6" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource ToolbarBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Margin="7,0" VerticalAlignment="Center" FontSize="10"
                                               FontWeight="SemiBold" Text="CLIP PREVIEW" />
                                </Border>
                                <ContentControl x:Name="SplitClipPreviewHost" Grid.Row="1" />
                            </Grid>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                                      Background="{StaticResource BorderBrush}" ShowsPreview="True" />
                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource ToolbarBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                    <TextBlock Margin="7,0" VerticalAlignment="Center" FontSize="10"
                                               FontWeight="SemiBold" Text="PROJECT PREVIEW" />
                                </Border>
                                <ContentControl x:Name="SplitProjectPreviewHost" Grid.Row="1" />
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border x:Name="LayersPanel"
                    Tag="Layers"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="0"
                    Grid.Column="4"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="44" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PROJECT LAYERS DATA" />
                            <Button Grid.Column="1"
                                    Margin="0,0,3,0"
                                    Click="AddTrack_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="+ Add track" />
                            <Button Grid.Column="2"
                                    Tag="Layers"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="7,6,7,3">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="PROJECT TRACKS" />
                        <TextBlock Grid.Row="1"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Timeline.TotalText}" />
                    </Grid>
                    <ScrollViewer Grid.Row="2" Margin="4,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProjectLayerGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,2"
                                              Style="{StaticResource LayerExpanderStyle}">
                                        <Expander.Header>
                                            <Border Padding="7,4" MinWidth="150" Background="{Binding HeaderColor}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                                    Tag="{Binding Header}" PreviewMouseLeftButtonDown="LayerHeader_PreviewMouseLeftButtonDown">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem CommandParameter="{Binding Header}" Click="TrackMoveUp_Click" Header="Move track up (render above)" />
                                                        <MenuItem CommandParameter="{Binding Header}" Click="TrackMoveDown_Click" Header="Move track down" />
                                                        <MenuItem CommandParameter="{Binding Header}" Click="ColorCode_Click" Header="Set track color…" />
                                                        <MenuItem CommandParameter="{Binding Header}" Click="AddCompatibleEffectContext_Click" Header="Add compatible effect…" />
                                                        <Separator />
                                                        <MenuItem Click="AddTrack_Click" Header="Add track…" />
                                                        <MenuItem CommandParameter="{Binding Header}" Click="RemoveTrackContext_Click" Header="Remove empty track" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <StackPanel>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Header.Title}" />
                                                    <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource FaintTextBrush}"
                                                               TextTrimming="CharacterEllipsis" Text="{Binding Header.Detail}" />
                                                </StackPanel>
                                            </Border>
                                        </Expander.Header>
                                        <ListBox ItemsSource="{Binding Items}" SelectionChanged="ProjectLayerList_SelectionChanged"
                                                 MouseDoubleClick="ProjectLayerList_MouseDoubleClick">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="7,4" Background="{Binding Color}"
                                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem CommandParameter="{Binding}" Click="EditLayerContext_Click" Header="Edit transform / effects…" />
                                                                <MenuItem CommandParameter="{Binding}" Click="AddClipEffectContext_Click" Header="Add compatible effect for this item…" />
                                                                <MenuItem CommandParameter="{Binding}" Click="ColorCode_Click" Header="Set item color…" />
                                                                <MenuItem CommandParameter="{Binding}" Click="LayerItemToggleEnabled_Click" Header="{Binding EnableActionText}" />
                                                                <MenuItem CommandParameter="{Binding}" Click="RemoveLayerContext_Click" Header="Remove item" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <StackPanel Opacity="{Binding ContentOpacity}">
                                                            <TextBlock FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                            <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource MutedTextBrush}"
                                                                       TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <WrapPanel Grid.Row="3" Margin="6">
                        <Button Click="TrackMoveUp_Click" Content="Track up" />
                        <Button Margin="4,0,0,0" Click="TrackMoveDown_Click" Content="Track down" />
                        <Button Margin="4,0,0,0" Click="RemoveTrack_Click" Content="- Track" />
                        <Button Margin="4,0,0,0" Click="EditLayer_Click" Content="Edit" />
                        <Button Margin="4,0,0,0" Click="ClipEffects_Click" Content="Transform / FX" />
                        <Button Margin="4,0,0,0" Click="RemoveLayer_Click" Content="Remove" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border x:Name="TimelinePanel"
                    Tag="Timeline"
                    PreviewMouseDown="WorkspacePanel_PreviewMouseDown"
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="5"
                    Margin="0,4,0,0"
                    Style="{StaticResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="31" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource ToolbarBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource PanelTitleStyle}" Text="PROJECT TIMELINE" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding Timeline.TotalText}" />
                            <TextBlock Grid.Column="2"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Timeline.RemainingText}" />
                            <Button Grid.Column="4" Click="ClearTimeline_Click" Style="{StaticResource HeaderButtonStyle}" Content="Clear" />
                            <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal">
                                <Button Margin="0,0,4,0" Click="AddTrack_Click" Style="{StaticResource HeaderButtonStyle}"
                                        Content="+ Add track" />
                                <Button Click="FitTimelineHorizontally_Click" Style="{StaticResource HeaderButtonStyle}"
                                        Content="Fit width" ToolTip="Fit the complete project duration into the visible timeline width" />
                                <Button Margin="3,0,4,0" Click="FitTimelineVertically_Click" Style="{StaticResource HeaderButtonStyle}"
                                        Content="Fit vertical" ToolTip="Fit all timelines into the visible height" />
                            </StackPanel>
                            <Button Grid.Column="5"
                                    Tag="Timeline"
                                    Click="PanelDock_Click"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Content="Dock" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="7,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Click="TimelineRulerMode_Click" Content="{Binding Timeline.RulerModeButtonText}" />
                        <Button Grid.Column="1" Margin="4,0,0,0" Click="TimelineSnapMode_Click"
                                Content="{Binding Timeline.SnapModeButtonText}" />
                        <TextBlock Grid.Column="2" Margin="9,0,4,0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="Time zoom" />
                        <Grid Grid.Column="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="29" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="0" Click="TimelineZoomOut_Click" Content="−"
                                    AutomationProperties.Name="Decrease time zoom" />
                            <Border Grid.Column="1" Margin="3,0" Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.TimeZoomText}" />
                            </Border>
                            <Button Grid.Column="2" Padding="0" Click="TimelineZoomIn_Click" Content="+"
                                    AutomationProperties.Name="Increase time zoom" />
                        </Grid>
                        <TextBlock Grid.Column="4" Margin="9,0,4,0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}" Text="Track height" />
                        <Grid Grid.Column="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="29" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="29" />
                            </Grid.ColumnDefinitions>
                            <Button Padding="0" Click="TrackHeightDecrease_Click" Content="−"
                                    AutomationProperties.Name="Decrease track height" />
                            <Border Grid.Column="1" Margin="3,0" Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}" Text="{Binding Timeline.TrackHeightText}" />
                            </Border>
                            <Button Grid.Column="2" Padding="0" Click="TrackHeightIncrease_Click" Content="+"
                                    AutomationProperties.Name="Increase track height" />
                        </Grid>
                        <Button Grid.Column="6" Margin="8,0,0,0" Click="MarkRangeStart_Click"
                                Content="Mark start" ToolTip="Set the selection start at the current frame" />
                        <Button Grid.Column="7" Margin="4,0,0,0" Click="MarkRangeEnd_Click"
                                Content="Mark end" ToolTip="Set the selection end at the current frame" />
                        <CheckBox x:Name="SnapToClipRangesCheckBox" Grid.Column="8" Margin="10,0,0,0"
                                  VerticalAlignment="Center" IsChecked="True" Content="Snap to clip ranges"
                                  ToolTip="Snap moved or resized layer edges to video clip starts and ends" />
                        <ProgressBar Grid.Column="9" Height="7" Margin="12,0,0,0" VerticalAlignment="Center"
                                     Maximum="100" Value="{Binding Timeline.Progress, Mode=OneWay}" />
                    </Grid>

                    <Grid x:Name="TimelineDropSurface" Grid.Row="2" Margin="6,0,6,6"
                          AllowDrop="True" Focusable="True"
                          DragOver="TimelineListBox_DragOver" Drop="TimelineListBox_Drop"
                          KeyDown="TimelineListBox_KeyDown">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="68" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <Border Height="34" Background="{StaticResource ToolbarBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,1">
                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="9" Foreground="{StaticResource FaintTextBrush}" Text="TRACK" />
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding TimelineLanes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Background="{Binding TrackColor}" Tag="{Binding TrackId}"
                                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,1"
                                                        Cursor="SizeNS" AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="TimelineTrackHeader_PreviewMouseLeftButtonDown"
                                                        MouseLeftButtonDown="TimelineTrackHeader_MouseLeftButtonDown"
                                                        PreviewMouseMove="TimelineTrackHeader_MouseMove"
                                                        DragOver="TimelineTrackHeader_DragOver"
                                                        Drop="TimelineTrackHeader_Drop">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem CommandParameter="{Binding}" Click="TimelineTrackMoveUp_Click" Header="Move track up (render above)" />
                                                            <MenuItem CommandParameter="{Binding}" Click="TimelineTrackMoveDown_Click" Header="Move track down" />
                                                            <MenuItem CommandParameter="{Binding}" Click="TimelineTrackColor_Click" Header="Set track color…" />
                                                            <MenuItem CommandParameter="{Binding}" Click="TimelineTrackAddEffect_Click" Header="Add compatible effect…" />
                                                            <Separator />
                                                            <MenuItem Click="AddTrack_Click" Header="Add track…" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock HorizontalAlignment="Center" FontSize="9" FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock HorizontalAlignment="Center" FontSize="9"
                                                                   Foreground="{StaticResource FaintTextBrush}" Text="{Binding ShortName}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <ScrollViewer x:Name="TimelineHorizontalScrollViewer" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <Grid x:Name="TimelineCanvas" Width="{Binding Timeline.TimelineWidth}"
                                          PreviewMouseRightButtonDown="TimelineCanvas_PreviewMouseRightButtonDown">
                                      <StackPanel>
                                        <Border x:Name="TimelineRulerSurface" Height="34" Background="{StaticResource InputBrush}"
                                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                Cursor="IBeam"
                                                PreviewMouseLeftButtonDown="TimelineRuler_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="TimelineRuler_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="TimelineRuler_PreviewMouseLeftButtonUp">
                                            <ItemsControl Width="{Binding Timeline.TimelineWidth}"
                                                          Height="32" ItemsSource="{Binding Timeline.RulerTicks}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                        <Setter Property="Canvas.Bottom" Value="0" />
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="105" Height="32">
                                                            <Border Width="1" Height="{Binding TickHeight}"
                                                                    HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                    Background="{StaticResource StrongBorderBrush}" />
                                                            <TextBlock Margin="3,1,0,0" FontSize="9"
                                                                       Foreground="{StaticResource MutedTextBrush}" Text="{Binding Label}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding TimelineLanes}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Tag="{Binding TrackId}" AllowDrop="True"
                                                            DragOver="TimelineLane_DragOver" DragLeave="TimelineLane_DragLeave"
                                                            Drop="TimelineLane_Drop"
                                                            MouseLeftButtonUp="TimelineLane_MouseLeftButtonUp"
                                                            Background="#191918" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1,0,1,1">
                                                        <Grid>
                                                          <ItemsControl Width="{Binding DataContext.Timeline.TimelineWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        ItemsSource="{Binding Items}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemContainerStyle>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                                                    <Setter Property="Canvas.Top" Value="2" />
                                                                </Style>
                                                            </ItemsControl.ItemContainerStyle>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border x:Name="TimelineItemBorder"
                                                                            Width="{Binding Width}" Height="{Binding Height}"
                                                                            Padding="4" Background="{Binding Background}"
                                                                            Cursor="SizeAll"
                                                                            BorderBrush="{StaticResource StrongBorderBrush}"
                                                                            BorderThickness="1" Tag="{Binding}"
                                                                            ToolTip="{Binding ToolTipText}"
                                                                            PreviewMouseLeftButtonDown="TimelineLaneItem_PreviewMouseLeftButtonDown"
                                                                            PreviewMouseMove="TimelineLaneItem_PreviewMouseMove"
                                                                            MouseLeftButtonDown="TimelineLaneItem_MouseLeftButtonDown">
                                                                        <Border.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineItemEdit_Click" Header="Edit item…" />
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineItemAddEffect_Click" Header="Add compatible effect…" />
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineItemColor_Click" Header="Set item color…" />
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineItemToggleEnabled_Click" Header="{Binding EnableActionText}" />
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineProgressCopyStyle_Click" Header="Copy progress style"
                                                                                          Visibility="{Binding IsProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineProgressPasteStyle_Click" Header="Paste progress style"
                                                                                          Visibility="{Binding IsProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                                <Separator />
                                                                                <MenuItem CommandParameter="{Binding}" Click="TimelineItemRemove_Click" Header="Remove item" />
                                                                            </ContextMenu>
                                                                        </Border.ContextMenu>
                                                                        <Grid ClipToBounds="True">
                                                                            <Image Opacity="0.34" Source="{Binding ThumbnailPath}"
                                                                                   Stretch="UniformToFill"
                                                                                   Visibility="{Binding IsVideo, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Grid>
                                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                                                <WrapPanel Visibility="{Binding ShowClipActions, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                                    <Button Padding="4,1" MinHeight="20" Click="MoveLeft_Click" Content="←" ToolTip="Move clip left" />
                                                                                    <Button Margin="2,0,0,0" Padding="4,1" MinHeight="20" Click="MoveRight_Click" Content="→" ToolTip="Move clip right" />
                                                                                    <Button Margin="2,0,0,0" Padding="4,1" MinHeight="20" Click="RemoveTimeline_Click" Content="×" ToolTip="Remove clip" />
                                                                                </WrapPanel>
                                                                                <StackPanel Grid.Row="1" VerticalAlignment="Center" Opacity="{Binding ContentOpacity}">
                                                                                    <TextBlock FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                                                    <TextBlock Margin="0,2,0,0" FontSize="9" Foreground="{StaticResource MutedTextBrush}"
                                                                                               TextTrimming="CharacterEllipsis" Text="{Binding Detail}" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                            <Border IsHitTestVisible="False"
                                                                                     BorderBrush="#C8A95A" BorderThickness="2" Opacity="0.78"
                                                                                     Visibility="{Binding NeedsProjectPreview, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                            <Thumb Width="7" HorizontalAlignment="Left" Cursor="SizeWE"
                                                                                    Tag="Start" Panel.ZIndex="5"
                                                                                    Background="{StaticResource AccentBrush}"
                                                                                    Visibility="{Binding CanResize, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                    DragStarted="TimelineItemResize_DragStarted"
                                                                                    DragDelta="TimelineItemResize_DragDelta"
                                                                                    DragCompleted="TimelineItemResize_DragCompleted">
                                                                                 <Thumb.Template>
                                                                                     <ControlTemplate TargetType="Thumb">
                                                                                         <Border Background="{TemplateBinding Background}" Opacity="0.82" />
                                                                                     </ControlTemplate>
                                                                                 </Thumb.Template>
                                                                             </Thumb>
                                                                            <Thumb Width="7" HorizontalAlignment="Right" Cursor="SizeWE"
                                                                                    Tag="End" Panel.ZIndex="5"
                                                                                    Background="{StaticResource AccentBrush}"
                                                                                    Visibility="{Binding CanResize, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                    DragStarted="TimelineItemResize_DragStarted"
                                                                                    DragDelta="TimelineItemResize_DragDelta"
                                                                                    DragCompleted="TimelineItemResize_DragCompleted">
                                                                                 <Thumb.Template>
                                                                                     <ControlTemplate TargetType="Thumb">
                                                                                         <Border Background="{TemplateBinding Background}" Opacity="0.82" />
                                                                                     </ControlTemplate>
                                                                                 </Thumb.Template>
                                                                             </Thumb>
                                                                        </Grid>
                                                                    </Border>
                                                                    <DataTemplate.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter TargetName="TimelineItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                            <Setter TargetName="TimelineItemBorder" Property="BorderThickness" Value="2" />
                                                                        </DataTrigger>
                                                                    </DataTemplate.Triggers>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                          </ItemsControl>
                                                          <Canvas IsHitTestVisible="False" Panel.ZIndex="8">
                                                              <Border Canvas.Left="{Binding DropPreviewLeft}"
                                                                      Width="{Binding DropPreviewWidth}"
                                                                      Height="{Binding DataContext.Timeline.TrackHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                      Margin="0,2,0,2" Padding="5,2"
                                                                      Background="#806F6658" BorderBrush="{StaticResource AccentBrush}"
                                                                      BorderThickness="2"
                                                                      Visibility="{Binding IsDropPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                  <TextBlock VerticalAlignment="Top" FontSize="9" FontWeight="SemiBold"
                                                                             Foreground="{StaticResource TextBrush}"
                                                                             Text="{Binding DropPreviewText}" />
                                                              </Border>
                                                          </Canvas>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </StackPanel>
                                      <Canvas IsHitTestVisible="False">
                                          <Border Canvas.Left="{Binding Timeline.RangeLeft}"
                                                  Width="{Binding Timeline.RangeWidth}"
                                                  Background="#385D554B" BorderBrush="#9A8E8071" BorderThickness="1,0"
                                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                          <TextBlock Canvas.Left="{Binding Timeline.RangeLeft}" Margin="5,12,0,0"
                                                     Padding="3,1" FontSize="9" Foreground="{StaticResource TextBrush}"
                                                     Background="#D02B2925" Text="{Binding Timeline.RangeText}"
                                                     Visibility="{Binding Timeline.HasRangeSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                          <Border Canvas.Left="{Binding Timeline.PlayheadLeft}"
                                                  Width="1" Background="{StaticResource AccentBrush}"
                                                  Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" />
                                          <Border Canvas.Left="{Binding Timeline.PlayheadLeft}" Width="9" Height="9"
                                                  Margin="-4,0,0,0" Background="{StaticResource AccentBrush}" />
                                          <TextBlock Canvas.Left="{Binding Timeline.PlayheadLeft}" Margin="7,2,0,0"
                                                     FontSize="9" Foreground="{StaticResource AccentBrush}"
                                                     Text="{Binding Timeline.PlayheadText}" />
                                      </Canvas>
                                      <Canvas Panel.ZIndex="4">
                                          <Thumb Canvas.Left="{Binding Timeline.RangeLeft}" Margin="-3,0,0,0"
                                                 Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                 Tag="Start" Style="{StaticResource TimelineRangeThumbStyle}"
                                                 Visibility="{Binding Timeline.HasRangeSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 DragStarted="TimelineRangeHandle_DragStarted"
                                                 DragDelta="TimelineRangeHandle_DragDelta"
                                                 DragCompleted="TimelineRangeHandle_DragCompleted" />
                                          <Thumb Canvas.Left="{Binding Timeline.RangeEndLeft}" Margin="-3,0,0,0"
                                                 Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"
                                                 Tag="End" Style="{StaticResource TimelineRangeThumbStyle}"
                                                 Visibility="{Binding Timeline.HasRangeSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 DragStarted="TimelineRangeHandle_DragStarted"
                                                 DragDelta="TimelineRangeHandle_DragDelta"
                                                 DragCompleted="TimelineRangeHandle_DragCompleted" />
                                      </Canvas>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="7,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="2"
                         Grid.ColumnSpan="2"
                         VerticalAlignment="Top"
                         Maximum="100"
                         Value="{Binding ScanProgress, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StatusText}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource FaintTextBrush}"
                       Text="{Binding ApplicationVersion}" />
        </Grid>
    </Grid>
</Window>
