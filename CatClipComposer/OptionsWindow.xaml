<Window x:Class="CatClipComposer.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Clip Composer — Preferences"
        Width="760"
        Height="850"
        MinWidth="680"
        MinHeight="600"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="14" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Preferences" />
            <TextBlock Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="Application folders, media library behavior, tools, and workspace defaults." />
        </StackPanel>

        <ScrollViewer x:Name="PreferencesScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Video library" />
                <TextBlock Margin="0,3,0,8"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="MP4, WebM, AVI, MOV, MKV, and M4V files are cataloged." />
                <Border MinHeight="105" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ListBox x:Name="SourceFoldersList"
                             ItemsSource="{Binding SourceFolders}"
                             SelectionMode="Extended" />
                </Border>
                <StackPanel Margin="0,5,0,8" Orientation="Horizontal">
                    <Button Click="AddSourceFolder_Click" Content="Add folder…" />
                    <Button Margin="4,0,0,0" Click="RemoveSourceFolder_Click" Content="Remove selected" />
                </StackPanel>
                <WrapPanel Margin="0,0,0,14">
                    <CheckBox x:Name="IncludeSubfoldersCheckBox"
                              Margin="0,0,18,0"
                              VerticalAlignment="Center"
                              Content="Include subfolders" />
                    <CheckBox x:Name="RescanOnStartupCheckBox"
                              VerticalAlignment="Center"
                              Content="Rescan clip library when the application starts" />
                </WrapPanel>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Library metadata folder" />
                <TextBlock Margin="0,3,0,5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="SQLite catalog, cached previews, and crash recovery are kept here." />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MetadataFolderTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Click="BrowseMetadataFolder_Click" Content="Browse…" />
                </Grid>
                <StackPanel Margin="0,0,0,14" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Contact-sheet slides per video" />
                    <TextBox x:Name="PreviewSlideCountTextBox" Width="54" Margin="8,0,0,0" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                               FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                               Text="1–24; new default is 12" />
                </StackPanel>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Content Browser thumbnails" />
                <TextBlock Margin="0,3,0,5" Foreground="{StaticResource MutedTextBrush}"
                           Text="Card widths used by the Small and Large grid modes." />
                <WrapPanel Margin="0,0,0,14">
                    <TextBlock VerticalAlignment="Center" Text="Small" />
                    <TextBox x:Name="SmallThumbnailSizeTextBox" Width="58" Margin="7,0,5,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                               Text="px (80–200)" />
                    <TextBlock Margin="22,0,0,0" VerticalAlignment="Center" Text="Large" />
                    <TextBox x:Name="LargeThumbnailSizeTextBox" Width="58" Margin="7,0,5,0" />
                    <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                               Text="px (140–360)" />
                </WrapPanel>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Final video output folder" />
                <Grid Margin="0,5,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Click="BrowseOutputFolder_Click" Content="Browse…" />
                </Grid>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Editable project folder" />
                <Grid Margin="0,5,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProjectFolderTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Click="BrowseProjectFolder_Click" Content="Browse…" />
                </Grid>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="Custom font folder" />
                <TextBlock Margin="0,3,0,5"
                           Foreground="{StaticResource MutedTextBrush}"
                           Text="TTF and OTF fonts here appear beside installed system fonts and are marked CUSTOM." />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomFontFolderTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Click="BrowseFontFolder_Click" Content="Browse…" />
                    <Button Grid.Column="2" Margin="4,0,0,0"
                            Click="OpenFontFolder_Click" Content="Open folder" />
                </Grid>

                <TextBlock FontSize="14" FontWeight="SemiBold" Text="FFmpeg executable" />
                <TextBlock Margin="0,3,0,5"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextWrapping="Wrap"
                           Text="The portable LGPL build in thirdparty\ffmpeg is used by default. Browse only to override it." />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FfmpegPathTextBox" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Margin="4,0,0,0"
                            Click="BrowseFfmpeg_Click" Content="Browse…" />
                </Grid>
                <Border x:Name="MissingFfmpegNotice"
                        Margin="0,0,0,14"
                        Padding="8"
                        Background="#29251F"
                        BorderBrush="{StaticResource StrongBorderBrush}"
                        BorderThickness="1">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0"
                                Click="DownloadFfmpeg_Click" Content="Open compatible downloads" />
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Text="Bundled FFmpeg is missing. Download the latest Windows x64 LGPL shared build, then restore the thirdparty\ffmpeg folder." />
                    </DockPanel>
                </Border>

                <CheckBox x:Name="ShowFileNamesCheckBox"
                          Margin="0,0,0,4"
                          Content="Show file names on catalog cards" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="90" IsCancel="True" Content="Cancel" />
            <Button MinWidth="96" Margin="5,0,0,0" IsDefault="True"
                    Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}" Content="Save preferences" />
        </StackPanel>
    </Grid>
</Window>
