<Window x:Class="CatClipComposer.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cat Clip Composer"
        Width="760" Height="470"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen">
    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Margin="10" Background="{StaticResource PreviewBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Image Source="pack://application:,,,/Assets/mr-cat-bee-splash.png"
                       Stretch="UniformToFill" />
            </Border>
            <Grid Grid.Column="1" Margin="18,22,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="26" FontWeight="SemiBold" Text="CAT CLIP COMPOSER" />
                <TextBlock Grid.Row="1" Margin="0,4,0,14" FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}" Text="Mr Cat is preparing the edit desk." />
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <TextBlock x:Name="StatusText" Margin="0,0,0,5" Text="Starting…" />
                    <ProgressBar x:Name="SplashProgressBar" Height="9" Minimum="0" Maximum="100" />
                </StackPanel>
                <Border Grid.Row="3" Background="#0E0E0D"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <ListBox x:Name="LogList" Margin="5" ItemsSource="{Binding LogLines}"
                             FontFamily="Consolas" FontSize="10"
                             Foreground="{StaticResource MutedTextBrush}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>
                <DockPanel Grid.Row="4" Margin="0,10,0,0">
                    <TextBlock VerticalAlignment="Center" FontSize="10"
                               Foreground="{StaticResource FaintTextBrush}" Text="Loading and library diagnostics" />
                    <Button x:Name="CancelButton" DockPanel.Dock="Right" MinWidth="80"
                            Visibility="Collapsed" Click="Cancel_Click" Content="Cancel" />
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
