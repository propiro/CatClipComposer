<Window x:Class="CatClipComposer.FfmpegCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Final FFmpeg command"
        Width="980"
        Height="620"
        MinWidth="720"
        MinHeight="420"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Final FFmpeg command" />
            <TextBlock Margin="0,5,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="This command uses the current project tracks and final output settings. You may edit its FFmpeg arguments before copying or executing it." />
            <TextBlock x:Name="OutputPathTextBlock"
                       Margin="0,5,0,0"
                       Foreground="{StaticResource AccentBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="SupportingFilesTextBlock"
                       Margin="0,3,0,0"
                       FontSize="10"
                       Foreground="{StaticResource FaintTextBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <TextBlock Margin="0,6,0,0"
                       Padding="7,5"
                       Background="#2A2420"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Direct execution bypasses Cat Clip Composer's temporary-output replacement and export-history recording. The configured FFmpeg executable is fixed; only its arguments may be edited." />
        </StackPanel>

        <TextBox x:Name="CommandTextBox"
                 Grid.Row="1"
                 Padding="9"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 FontFamily="Consolas"
                 FontSize="12"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap"
                 SpellCheck.IsEnabled="False"
                 ToolTip="Editable executable and FFmpeg argument text. Execute FFmpeg permits only the configured FFmpeg executable, not another program." />

        <TextBlock x:Name="StatusTextBlock"
                   Grid.Row="2"
                   Margin="0,9,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Command ready."
                   TextWrapping="Wrap" />

        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="CloseButton"
                    DockPanel.Dock="Right"
                    MinWidth="90"
                    IsCancel="True"
                    Click="Close_Click"
                    Content="Close"
                    ToolTip="Close this command window. A running FFmpeg process must be cancelled first." />
            <Button x:Name="ExecuteButton"
                    DockPanel.Dock="Right"
                    MinWidth="150"
                    Margin="0,0,8,0"
                    Click="Execute_Click"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Content="EXECUTE FFMPEG"
                    ToolTip="Run the edited arguments directly through the configured FFmpeg executable." />
            <Button x:Name="CopyButton"
                    DockPanel.Dock="Right"
                    MinWidth="165"
                    Margin="0,0,8,0"
                    Click="Copy_Click"
                    Content="COPY TO CLIPBOARD"
                    ToolTip="Copy the complete edited FFmpeg command to the Windows clipboard." />
        </DockPanel>
    </Grid>
</Window>
