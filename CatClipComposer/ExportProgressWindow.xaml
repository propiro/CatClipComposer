<Window x:Class="CatClipComposer.ExportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export progress"
        Width="760"
        Height="560"
        MinWidth="620"
        MinHeight="440"
        Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,10">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Exporting compilation" />
            <TextBlock x:Name="SummaryTextBlock" Margin="0,4,0,0"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="DestinationTextBlock" Margin="0,3,0,0"
                       Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar x:Name="ExportProgressBar" Grid.Row="1" Height="18"
                     Minimum="0" Maximum="100" Value="0" />

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PercentTextBlock" FontWeight="SemiBold" Text="0.0%" />
            <TextBlock x:Name="MediaTimeTextBlock" Grid.Column="1"
                       Foreground="{StaticResource MutedTextBrush}" Text="Timeline: preparing" />
            <TextBlock x:Name="ElapsedTextBlock" Grid.Column="2" TextAlignment="Right"
                       Foreground="{StaticResource MutedTextBrush}" Text="Elapsed: 0:00" />
        </Grid>

        <Border Grid.Row="3" Margin="0,10,0,10" Padding="10,8"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1">
            <TextBlock x:Name="StageTextBlock" FontWeight="SemiBold" TextWrapping="Wrap"
                       Text="Preparing export operation…" />
        </Border>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Export activity" />
            <TextBox x:Name="ActivityTextBox" Grid.Row="1"
                     IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Consolas" FontSize="11"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap"
                     ToolTip="Timestamped stages reported by project mapping, FFmpeg, destination replacement, and export-history recording." />
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="True">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" MinWidth="90"
                    IsEnabled="False" IsCancel="True" Click="Close_Click" Content="CLOSE" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" MinWidth="100" Margin="0,0,8,0"
                    Click="Cancel_Click" Content="CANCEL"
                    ToolTip="Stop FFmpeg and keep the existing destination file unchanged." />
            <Button x:Name="OpenOutputButton" DockPanel.Dock="Right" MinWidth="145" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="OpenOutput_Click" Content="SHOW OUTPUT"
                    ToolTip="Select the completed video in File Explorer." />
            <TextBlock x:Name="ResultTextBlock" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
        </DockPanel>
    </Grid>
</Window>
