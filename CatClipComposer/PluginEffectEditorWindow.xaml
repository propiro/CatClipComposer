<Window x:Class="CatClipComposer.PluginEffectEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CatClipComposer.Controls"
        Title="Plugin effect" Width="660" Height="720" MinWidth="580" MinHeight="560"
        Background="{StaticResource WindowBrush}" WindowStartupLocation="CenterOwner">
    <Grid Margin="14" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Text="Add plugin effect" />
            <TextBlock x:Name="TrackText" Margin="0,3,0,0" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Margin="0,0,0,10" Padding="10" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Text="EFFECT MODULE" />
                        <TextBlock Margin="0,0,0,4" Text="Effect type" />
                        <ComboBox x:Name="PluginComboBox" DisplayMemberPath="Descriptor.Name"
                                  SelectionChanged="PluginComboBox_SelectionChanged"
                                  ToolTip="Choose an effect compatible with the target timeline." />
                        <TextBlock x:Name="DescriptionText" Margin="0,5,0,0" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,10" Padding="10" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Text="TIMELINE RANGE" />
                        <controls:TimeRangeEditorControl x:Name="TimeRangeEditor"
                                                         ToolTip="Set when this effect starts and ends on the project timeline." />
                        <TextBlock x:Name="SnapText" Margin="0,5,0,0" FontSize="10"
                                   Foreground="{StaticResource FaintTextBrush}" />
                    </StackPanel>
                </Border>
                <Border Padding="10" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Text="EFFECT ADJUSTMENTS" />
                        <StackPanel x:Name="ParametersPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="FramePreviewControls" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PreviewFrameButton" Click="PreviewFrame_Click"
                        Content="Prerender frame with background"
                        ToolTip="Render this effect with its unsaved settings over the current project frame." />
                <CheckBox x:Name="AutoPreviewCheckBox" Margin="9,0,0,0" VerticalAlignment="Center"
                          Content="Auto refresh"
                          ToolTip="Refresh the open frame preview after effect settings change." />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button MinWidth="80" IsCancel="True" Content="Cancel"
                        ToolTip="Close without applying these effect settings." />
                <Button x:Name="ApplyButton" MinWidth="110" Margin="5,0,0,0" Click="Apply_Click"
                        Style="{StaticResource PrimaryButtonStyle}" Content="Add effect"
                        ToolTip="Apply these settings to the timeline effect." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
