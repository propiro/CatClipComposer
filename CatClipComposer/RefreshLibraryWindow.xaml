<Window x:Class="CatClipComposer.RefreshLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Refresh clip library"
        Width="540" Height="245" MinWidth="500" MinHeight="230"
        ResizeMode="NoResize" Background="{StaticResource WindowBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Refresh clip library" />
            <TextBlock Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="Choose whether to keep valid cached thumbnails and contact sheets, or rebuild every preview image." />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,15,0,0">
            <Button Height="42" HorizontalContentAlignment="Left" Click="CatalogOnly_Click"
                    Content="Refresh catalog only  —  detect new, changed, moved, or missing clips" />
            <Button Height="42" Margin="0,6,0,0" HorizontalContentAlignment="Left"
                    Click="Regenerate_Click"
                    Content="Refresh catalog + regenerate thumbnails and preview sheets" />
        </StackPanel>
        <Button Grid.Row="2" Width="88" HorizontalAlignment="Right" IsCancel="True" Content="Cancel" />
    </Grid>
</Window>
