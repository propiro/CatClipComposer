<UserControl x:Class="CatClipComposer.Controls.TimeRangeEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CatClipComposer.Controls">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Margin="0,0,0,4" Text="Start (seconds)" />
                <controls:NumericEditorControl x:Name="StartEditor" ShowSlider="False" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="EndLabel" Margin="0,0,0,4" Text="End (seconds)" />
                <controls:NumericEditorControl x:Name="EndEditor" ShowSlider="False" />
            </StackPanel>
        </Grid>
        <Grid Margin="0,8,0,0" Height="43">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="15" />
            </Grid.RowDefinitions>
            <Border Margin="4,5" Background="{StaticResource InputBrush}"
                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" />
            <Canvas x:Name="MiniTrackCanvas" Background="Transparent" ClipToBounds="True"
                    SizeChanged="MiniTrackCanvas_SizeChanged">
                <Thumb x:Name="RangeMoveThumb" Height="16" Canvas.Top="6" Cursor="SizeAll"
                       Panel.ZIndex="1" Background="#806F6658"
                       DragStarted="MiniTrack_DragStarted" DragDelta="MiniTrack_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="RangeStartThumb" Width="10" Height="24" Canvas.Top="2" Cursor="SizeWE"
                       Panel.ZIndex="2" Tag="Start" Background="{StaticResource AccentBrush}"
                       DragStarted="MiniTrack_DragStarted" DragDelta="MiniTrack_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Thumb x:Name="RangeEndThumb" Width="10" Height="24" Canvas.Top="2" Cursor="SizeWE"
                       Panel.ZIndex="2" Tag="End" Background="{StaticResource AccentBrush}"
                       DragStarted="MiniTrack_DragStarted" DragDelta="MiniTrack_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Canvas>
            <TextBlock Grid.Row="1" Margin="2,0" FontSize="9" Foreground="{StaticResource FaintTextBrush}"
                       Text="0" />
            <TextBlock x:Name="MiniTrackEndText" Grid.Row="1" Margin="2,0" HorizontalAlignment="Right"
                       FontSize="9" Foreground="{StaticResource FaintTextBrush}" />
        </Grid>
        <Grid Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Padding="7,2" Click="SetStartZero_Click" Content="Set start to 0" />
            <Button Grid.Column="1" Margin="5,0,0,0" Padding="7,2"
                    Click="SetEndProject_Click" Content="Set end to last clip" />
            <CheckBox x:Name="UseDurationCheckBox" Grid.Column="2" Margin="12,0,0,0"
                      VerticalAlignment="Center" Content="Enter duration instead of end time"
                      Checked="UseDurationCheckBox_Changed"
                      Unchecked="UseDurationCheckBox_Changed" />
        </Grid>
    </StackPanel>
</UserControl>
