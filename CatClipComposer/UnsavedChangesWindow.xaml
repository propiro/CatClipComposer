<Window x:Class="CatClipComposer.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unsaved project changes"
        Width="470" Height="205" MinWidth="420" MinHeight="190"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Save this project before closing?" />
            <TextBlock x:Name="ProjectNameText" Margin="0,9,0,0"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
            <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"
                       Text="Don't save permanently discards the unsaved project changes." />
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal">
            <Button MinWidth="82" IsCancel="True" Content="Cancel" />
            <Button MinWidth="100" Margin="5,0,0,0" Click="DontSave_Click" Content="Don't save" />
            <Button MinWidth="82" Margin="5,0,0,0" IsDefault="True" Click="Save_Click"
                    Style="{StaticResource PrimaryButtonStyle}" Content="Save" />
        </StackPanel>
    </Grid>
</Window>
