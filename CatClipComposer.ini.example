; Copy as CatClipComposer.ini beside the executable. The application also creates it when Preferences are saved.

[Sources]
IncludeSubfolders=true
ShowFileNames=true
RescanLibraryOnStartup=true

[Library]
MetadataFolder=
PreviewSlideCount=12
BrowserViewMode=SmallGrid
SmallThumbnailSize=120
LargeThumbnailSize=220

[Output]
Folder=
ProjectFolder=

[Tools]
FfmpegPath=ffmpeg.exe
CustomFontFolder=fonts

[Workspace]
ContentBrowserDock=Left
PreviewDock=Center
LayersDock=Right
TimelineDock=Bottom
