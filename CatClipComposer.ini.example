; Copy as CatClipComposer.ini beside the executable. The application also creates it when Options are saved.

[Sources]
IncludeSubfolders=true
ShowFileNames=true

[Library]
MetadataFolder=
PreviewSlideCount=4

[Output]
Folder=
ProjectFolder=
TargetDurationMinutes=15
Orientation=Landscape
VideoEncoder=NativeMpeg4

[Tools]
FfmpegPath=ffmpeg.exe

[Overlays]
ProgressStyle=None
ImagePath=
Text=
FontPath=
TextSize=42
Position=TopRight

[Workspace]
ContentBrowserDock=Left
PreviewDock=Center
LayersDock=Right
TimelineDock=Bottom
